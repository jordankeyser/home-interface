[Unit]
Description=Home Interface control server (static build, CTA proxy, backlight)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
ExecStart=__NODE__ __APP_DIR__/server/index.js
Restart=always
RestartSec=5

# Needs sysfs backlight writes, granted via the udev rule install.sh adds plus
# membership of the video group.
SupplementaryGroups=video

# Deliberately minimal. An earlier version of this unit also set
# ProtectSystem=full, ProtectHome=read-only and PrivateTmp=yes; that hardening
# was never tested on-device and turned any failure into a silent exit-1
# restart loop. This service already listens on loopback only and serves a
# static build, so the sandboxing bought very little. Do not add directives here
# without confirming the service still starts on the Pi.

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
